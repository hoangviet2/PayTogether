# Copy to Backend/.env (never commit). Every integration is optional; missing keys turn that feature off with a clear message.
PORT=8787

# Wayfinder (OpenAI). Required for the chat to plan anything.
OPENAI_API_KEY=

# PayPal sandbox: developer.paypal.com → Apps & Credentials. The webhook needs a public URL
# (e.g. a tunnel to http://localhost:8787/api/paypal/webhook) subscribed to
# CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.DECLINED.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Log in with PayPal uses the same app: Apps & Credentials → your app → Features → turn on "Log in with PayPal",
# add the web app's address with no trailing slash (http://localhost:5173, https://<service>.onrender.com) as a Return URL,
# tick Full name + Email, and set Privacy policy + User agreement URLs (https://example.com is fine for sandbox).

# Channel3 product search (Shop tab, Wayfinder's search_products)
CHANNEL3_API_KEY=

# Kernel cloud browser (Shop → Assisted checkout)
KERNEL_API_KEY=

# Elasticsearch (Spending search). Without it, search runs in-process.
ELASTIC_URL=
ELASTIC_API_KEY=

# Required on any public host (Render generates one). Requests without x-access-token: <value> get 401,
# except /api/config (health check) and /api/paypal/webhook (PayPal-signed).
ACCESS_TOKEN=

# The web app's origin(s), comma-separated, allowed to call this API from the browser (CORS).
# Not needed in dev: Vite proxies /api, so requests are same-origin.
WEB_ORIGIN=

# Signs Log in with PayPal sessions. Any long random string; if unset, sessions end when the server restarts.
SESSION_SECRET=
